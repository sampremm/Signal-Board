# Signal Board Antifragile Serverless Configuration
PORT=5001

# Database Connections (Neon Serverless PostgreSQL)
# DATABASE_URL is the pooled connection for high-throughput edge functions
DATABASE_URL="postgresql://mock_user:mock_password@ep-mock-neon-pooler.us-east-1.aws.neon.tech/signalboard?sslmode=require"
# DIRECT_URL is used by Prisma for direct migrations and schema syncing
DIRECT_URL="postgresql://mock_user:mock_password@ep-mock-neon-direct.us-east-1.aws.neon.tech/signalboard?sslmode=require"

# Upstash Serverless Redis for Distributed Circuit Breaking & Rate Limiting
UPSTASH_REDIS_REST_URL="https://mock-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="mock_upstash_token"

# Primary AI Provider: Google Gemini AI Key
GEMINI_API_KEY="mock_gemini_api_key_replace_me"

# Secondary AI Provider (Optional Fallback): Groq API Key (console.groq.com)
GROQ_API_KEY=""

# Authentication Secret
JWT_SECRET="antifragile-signal-board-secret-key-2026"
